# Ollama connection (local defaults)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Sync ingested docs into Postgres + Neo4j (set false to disable)
RAG_SYNC_GRAPH_DB=true

# Postgres (docker-compose defaults)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=academic_rag

# Neo4j (docker-compose defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragpassword

# Leiden community detection (Neo4j GDS); higher → more communities
LEIDEN_GAMMA=1.0
